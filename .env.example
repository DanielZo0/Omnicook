# Browser-safe configuration. Used only as an "is auth configured" feature
# flag on the client — the auth client actually talks to this app's own
# /api/auth proxy (same origin), not this URL directly.
NEXT_PUBLIC_NEON_AUTH_BASE_URL=

# Server-only configuration. Never prefix these with NEXT_PUBLIC_.
# Get these by running `npx neon@latest neon-auth enable` on your Neon project.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Neon Postgres connection string (from the Neon dashboard). All database
# access happens server-side via API routes — this must never reach the browser.
DATABASE_URL=

# Groq is the primary extraction provider (free tier, works from a deployed
# server). NVIDIA (build.nvidia.com, also free-tier), xAI, and Gemini are
# fallbacks, tried in that order, when GROQ_API_KEY is unset.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
XAI_API_KEY=
XAI_MODEL=grok-4
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
